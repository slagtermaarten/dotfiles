#!/bin/bash

# Extract a column from a csv file
# Use getopt for argument parsing
OPTIONS=$(getopt -o f:c:i: --file:,column:,index: -- "$@")
eval set -- "$OPTIONS"
while true; do
  case "$1" in
    -f|--file)
      FILE="$2"
      shift 2
      ;;
    -c|--column)
      COLUMN="$2"
      shift 2
      ;;
    -i|--index)
      INDEX="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *)
      echo "Invalid option: $1"
      exit 1
      ;;
  esac
done

# Check if the file exists
if [ ! -f "$FILE" ]; then
  echo "File not found!"
  exit 1
fi

# If column name is provided, find the index
if [ -n "$COLUMN" ]; then
  HEADER=$(head -n 1 "$FILE")
  IFS=',' read -r -a HEADERS <<< "$HEADER"
  INDEX=-1
  for i in "${!HEADERS[@]}"; do
    if [ "${HEADERS[$i]}" == "$COLUMN" ]; then
      INDEX=$i
      break
    fi
  done

  if [ $INDEX -eq -1 ]; then
    echo "Column name not found!"
    exit 1
  fi

  # Add 1 to convert to 1-based index for cut
  INDEX=$((INDEX + 1))
fi

cut -d',' -f"$INDEX" "$FILE"

