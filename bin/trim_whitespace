#!/usr/bin/env python3

import os
import re
from pathlib import Path

# Directories to entirely skip to avoid modifying data, cache, or vendored files
IGNORE_DIRS = {
    '.git', '.venv', '.ruff_cache', '__pycache__',
    'target', 'data', 'results', 'test_parse',
}

# File extensions that are safe to trim
ALLOWED_EXTS = {
    '.py', '.rs', '.html', '.md', '.json', '.toml', '.yml', '.yaml', '.sh', '.go'
}

# Explicit files to skip (e.g., massive generated files)
EXCLUDE_FILES = {
    'gene_byte_index.json', 'uv.lock'
}

def trim_trailing_whitespace(file_path: Path) -> bool:
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            content = f.read()
    except (UnicodeDecodeError, OSError):
        return False

    # Regex to match 1 or more spaces/tabs at the end of a line
    new_content = re.sub(r'[ \t]+$', '', content, flags=re.MULTILINE)

    if new_content != content:
        with open(file_path, 'w', encoding='utf-8') as f:
            f.write(new_content)
        return True

    return False

def main():
    root_dir = './'
    changed_count = 0

    for dirpath, dirnames, filenames in os.walk(root_dir):
        # Prune ignored directories in-place so os.walk skips them
        dirnames[:] = [d for d in dirnames if d not in IGNORE_DIRS]

        for filename in filenames:
            file_path = Path(dirpath) / filename

            if filename in EXCLUDE_FILES:
                continue

            if file_path.suffix in ALLOWED_EXTS or filename in {'Taskfile.yml', 'Taskfile.yaml'}:
                if trim_trailing_whitespace(file_path):
                    print(f"Trimmed: {file_path.relative_to(root_dir)}")
                    changed_count += 1

    print(f"\nDone. Trimmed trailing whitespace in {changed_count} files.")

if __name__ == '__main__':
    main()
